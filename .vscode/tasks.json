{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Deploy everything",
            "dependsOn": [
                "Deploy color_sensor to armtarget1",
                "Deploy controller to armtarget2",
                "Deploy presence sensor to armtarget3",
                "Deploy dobot to armtarget4"
            ],
            "problemMatcher": []
        },
        {
            "label": "kill everything",
            "dependsOn": [
                "Kill color_sensor",
                "Kill controller",
                "Kill presence sensor",
                "Kill dobot"
            ],
            "problemMatcher": []
        },
        {
            "label": "Deploy color_sensor to armtarget1",
            "type": "shell",
            "command": "scp",
            "args": [
                "target/aarch64-unknown-linux-gnu/release/color_sensor",
                "pi@armtarget1:~/"
            ],
            "problemMatcher": [],
        },
        {
            "label": "Kill color_sensor",
            "type": "shell",
            "command": "ssh",
            "args": [
                "pi@armtarget1", "sudo killall color_sensor --quiet"
            ]
        },
        {
            "label": "Deploy controller to armtarget2",
            "type": "shell",
            "command": "scp",
            "args": [
                "target/aarch64-unknown-linux-gnu/release/controller",
                "pi@armtarget2:~/"
            ],
            "problemMatcher": []
        },
        {
            "label": "Kill controller",
            "type": "shell",
            "command": "ssh",
            "args": [
                "pi@armtarget2", "sudo killall controller --quiet"
            ]
        },
        {
            "label": "Deploy presence sensor to armtarget3",
            "type": "shell",
            "command": "scp",
            "args": [
                "target/aarch64-unknown-linux-gnu/release/presence_sensor",
                "pi@armtarget3:~/"
            ],
            "problemMatcher": []
        },
        {
            "label": "Kill presence sensor",
            "type": "shell",
            "command": "ssh",
            "args": [
                "pi@armtarget3", "sudo killall presence_sensor --quiet"
            ]
        },
        {
            "label": "Deploy dobot to armtarget4",
            "type": "shell",
            "command": "scp",
            "args": [
                "target/aarch64-unknown-linux-gnu/release/dobot",
                "pi@armtarget4:~/"
            ],
            "problemMatcher": []
        },
        {
            "label": "Kill dobot",
            "type": "shell",
            "command": "ssh",
            "args": [
                "pi@armtarget4", "sudo killall dobot --quiet"
            ]
        },
        {
            "label": "cargo build --release",
            "type": "cargo",
            "command": "build",
            "args": [
                "--release"
            ],
            "problemMatcher": [
                "$rustc"
            ],
            "group": "build"
        }
    ]
}