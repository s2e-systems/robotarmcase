module robot_arm_case {

    enum Presence {
        Present,
        NotPresent
    };

    enum Color
    {
        Red,
        Blue,
        Green,
        Undefined
    };

    enum Suction
    {
        On,
        Off
    };

    struct SuctionCupCommand
    {
        @key
        short id;
        Suction suction;
    };

    struct ConveyorBeltSpeed
    {
        @key
        short id;
        short speed;
    };

    enum MoveType
    {
        moveJ,
        moveL,
        jump
    };

    struct RobotPose
    {
        @key
        short id;
        float x;
        float y;
        float z;
        float r;
    };

    struct RobotArmMoveCommand
    {
        @key
        short id;
        MoveType move;
        RobotPose pose;
    };

    enum Availability {
        available,
        not_available
    };

    struct HousekeepingData
    {
        @key
        short id;
        Availability availability;
    };

};